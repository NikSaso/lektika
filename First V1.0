<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f5f7fa">

<title>Λεκτικά — Sales Toolkit</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

/* =====================================================
   VARIABLES
===================================================== */

:root {
  --bg: #f5f7fa;
  --surface: #ffffff;
  --surface2: #eef1f5;

  --text: #202633;
  --muted: #7c8491;

  --border: #e1e6ec;

  --blue: #005baa;
  --blue-dark: #004681;
  --blue-soft: #eaf3fb;

  --orange: #f58220;
  --orange-dark: #c95e08;
  --orange-soft: #fff1e5;

  --green: #31a66b;
  --green-dark: #247a50;
  --green-soft: #eaf8f1;

  --red: #df6666;
  --red-dark: #a84444;
  --red-soft: #fff0f0;

  --yellow: #eabf43;
  --yellow-soft: #fff8df;

  --dark: #202633;

  --radius: 20px;

  --shadow:
    0 7px 25px rgba(32,38,51,.055);
}


/* =====================================================
   RESET
===================================================== */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);

  font-family: "Inter", sans-serif;

  -webkit-font-smoothing: antialiased;
}

button,
input,
select {
  font: inherit;
  -webkit-tap-highlight-color: transparent;
}


/* =====================================================
   PAGE
===================================================== */

.page {
  width: 100%;
  max-width: 760px;

  margin: 0 auto;

  padding: 17px 15px 55px;
}


/* =====================================================
   HEADER
===================================================== */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 15px;
}

.logo-area {
  display: flex;
  flex-direction: column;
}

.eyebrow {
  color: var(--blue);

  font-size: 7px;
  font-weight: 800;

  letter-spacing: 2px;
}

.logo {
  margin-top: -3px;

  font-family: "Baloo 2", sans-serif;

  font-size: 39px;
  line-height: 1;

  font-weight: 800;

  color: var(--blue);
}

.logo span {
  color: var(--orange);
}

.theme-button {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--border);
  border-radius: 13px;

  background: var(--surface);
  color: var(--text);

  box-shadow: var(--shadow);

  font-size: 17px;

  cursor: pointer;

  transition: transform .18s ease;
}

.theme-button:active {
  transform: scale(.9);
}


/* =====================================================
   HERO
===================================================== */

.hero {
  position: relative;

  overflow: hidden;

  padding: 25px 20px 23px;

  border-radius: 25px;

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(245,130,32,.95),
      transparent 31%
    ),
    radial-gradient(
      circle at 0% 100%,
      rgba(0,91,170,.95),
      transparent 40%
    ),
    #173a5c;

  color: white;

  box-shadow:
    0 14px 35px rgba(0,72,129,.13);
}

.hero:after {
  content: "✦";

  position: absolute;

  right: 12px;
  bottom: -8px;

  color: rgba(255,255,255,.08);

  font-size: 92px;

  pointer-events: none;
}

.hero-badge {
  display: inline-flex;

  padding: 6px 10px;

  border: 1px solid rgba(255,255,255,.15);
  border-radius: 50px;

  background: rgba(255,255,255,.09);

  font-size: 8px;
  font-weight: 700;
}

.hero h1 {
  position: relative;
  z-index: 1;

  margin: 16px 0 7px;

  font-family: "Baloo 2", sans-serif;

  font-size: clamp(33px, 9vw, 49px);

  line-height: .93;

  letter-spacing: -1px;
}

.hero h1 span {
  color: #ffad69;
}

.hero-description {
  position: relative;
  z-index: 1;

  max-width: 580px;

  margin: 0;

  color: #e2eaf2;

  font-size: 10.5px;

  line-height: 1.55;
}


/* =====================================================
   INTRO
===================================================== */

.intro {
  display: flex;
  align-items: center;
  gap: 9px;

  margin: 18px 3px 15px;

  color: var(--muted);

  font-size: 9px;
  font-weight: 600;

  line-height: 1.4;
}

.intro:before {
  content: "";

  width: 21px;
  height: 2px;

  flex: 0 0 21px;

  border-radius: 20px;

  background: var(--orange);
}


/* =====================================================
   MAIN ACCORDION
===================================================== */

.accordion {
  display: flex;
  flex-direction: column;

  gap: 9px;
}


/* =====================================================
   MAIN ITEM
===================================================== */

.accordion-item {
  border: 1px solid var(--border);

  border-radius: var(--radius);

  background: var(--surface);

  box-shadow: var(--shadow);

  overflow: hidden;

  transition:
    box-shadow .2s ease,
    border-color .2s ease;
}

.accordion-item.open {
  box-shadow:
    0 12px 32px rgba(32,38,51,.075);
}


/* =====================================================
   MAIN HEADER
===================================================== */

.accordion-header {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 16px 14px;

  border: 0;

  background: transparent;

  color: var(--text);

  text-align: left;

  cursor: pointer;
}

.section-icon {
  width: 43px;
  height: 43px;

  flex: 0 0 43px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  font-size: 18px;
  font-weight: 800;
}

.icon-blue {
  background: var(--blue-soft);
  color: var(--blue);
}

.icon-orange {
  background: var(--orange-soft);
  color: var(--orange-dark);
}

.icon-green {
  background: var(--green-soft);
  color: var(--green-dark);
}

.icon-yellow {
  background: var(--yellow-soft);
  color: #997715;
}

.icon-red {
  background: var(--red-soft);
  color: var(--red-dark);
}

.section-info {
  min-width: 0;
  flex: 1;
}

.section-number {
  margin-bottom: 2px;

  color: var(--muted);

  font-size: 7px;
  font-weight: 800;

  letter-spacing: 1.2px;
}

.section-name {
  margin: 0;

  font-family: "Baloo 2", sans-serif;

  font-size: 22px;

  line-height: 1;
}

.section-subtitle {
  margin-top: 4px;

  color: var(--muted);

  font-size: 8.5px;
}

.chevron {
  width: 29px;
  height: 29px;

  flex: 0 0 29px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: var(--surface2);

  color: var(--muted);

  font-size: 15px;

  transition: transform .25s ease;
}

.accordion-item.open .chevron {
  transform: rotate(180deg);
}


/* =====================================================
   CONTENT
===================================================== */

.accordion-content {
  display: grid;

  grid-template-rows: 0fr;

  transition:
    grid-template-rows .32s cubic-bezier(.4,0,.2,1);
}

.accordion-item.open .accordion-content {
  grid-template-rows: 1fr;
}

.accordion-inner {
  overflow: hidden;
  min-height: 0;
}

.accordion-body {
  padding: 0 9px 10px;
}


/* =====================================================
   SUBCATEGORY
===================================================== */

.subcategory {
  border-top: 1px solid var(--border);
}

.subcategory:first-child {
  border-top: 0;
}

.subcategory-button {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 14px 8px;

  border: 0;

  background: transparent;

  color: var(--text);

  text-align: left;

  cursor: pointer;
}

.subcategory-button:active {
  transform: scale(.995);
}

.subcategory-icon {
  width: 31px;
  height: 31px;

  flex: 0 0 31px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: var(--surface2);

  color: var(--blue);

  font-size: 13px;
  font-weight: 800;
}

.subcategory.orange .subcategory-icon {
  color: var(--orange-dark);
}

.subcategory.green .subcategory-icon {
  color: var(--green-dark);
}

.subcategory.red .subcategory-icon {
  color: var(--red-dark);
}

.subcategory-info {
  min-width: 0;
  flex: 1;
}

.subcategory-title {
  margin: 0;

  font-size: 10.5px;
  font-weight: 800;

  line-height: 1.3;
}

.subcategory-count {
  margin-top: 2px;

  color: var(--muted);

  font-size: 7.5px;
}

.subcategory-chevron {
  width: 26px;
  height: 26px;

  flex: 0 0 26px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;

  background: var(--surface2);

  color: var(--muted);

  font-size: 13px;

  transition: transform .25s ease;
}

.subcategory.open .subcategory-chevron {
  transform: rotate(180deg);
}


/* =====================================================
   SUB CONTENT
===================================================== */

.subcategory-content {
  display: grid;

  grid-template-rows: 0fr;

  transition:
    grid-template-rows .28s cubic-bezier(.4,0,.2,1);
}

.subcategory.open .subcategory-content {
  grid-template-rows: 1fr;
}

.subcategory-inner {
  min-height: 0;
  overflow: hidden;
}

.subcategory-body {
  padding: 0 8px 13px;
}


/* =====================================================
   PHRASES
===================================================== */

.phrase-list {
  display: grid;
  gap: 6px;
}

.phrase {
  min-height: 50px;

  display: flex;
  align-items: center;

  padding: 10px 12px;

  border: 1px solid var(--border);

  border-radius: 12px;

  background: var(--surface);
}

.phrase-positive {
  border-left: 3px solid var(--green);
}

.phrase-negative {
  border-left: 3px solid var(--red);
}

.phrase p {
  margin: 0;

  font-size: 10.5px;

  line-height: 1.42;

  font-weight: 600;
}


/* =====================================================
   EXAMPLE
===================================================== */

.example {
  margin-top: 8px;

  padding: 13px;

  border: 1px solid #f1dda8;

  border-radius: 13px;

  background: var(--yellow-soft);
}

.example-label {
  color: #96731c;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .9px;

  text-transform: uppercase;
}

.example p {
  margin: 6px 0 0;

  color: #59491f;

  font-family: "Baloo 2", sans-serif;

  font-size: 14px;

  line-height: 1.4;
}


/* =====================================================
   BETTER
===================================================== */

.better {
  margin-top: 9px;

  padding: 10px;

  border-radius: 13px;

  background: var(--green-soft);
}

.better-title {
  margin: 0 3px 7px;

  color: var(--green-dark);

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .9px;

  text-transform: uppercase;
}


/* =====================================================
   SWAPS
===================================================== */

.swap-list {
  display: grid;
  gap: 7px;
}

.swap {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    22px
    minmax(0,1fr);

  align-items: center;

  gap: 4px;

  padding: 11px;

  border: 1px solid var(--border);

  border-radius: 14px;

  background: var(--surface);
}

.swap-label {
  margin-bottom: 4px;

  font-size: 6.5px;
  font-weight: 800;

  letter-spacing: .6px;

  text-transform: uppercase;
}

.swap-bad .swap-label {
  color: var(--red-dark);
}

.swap-good .swap-label {
  color: var(--green-dark);
}

.swap-text {
  font-size: 9.5px;

  line-height: 1.4;

  font-weight: 600;
}

.swap-arrow {
  display: flex;
  align-items: center;
  justify-content: center;

  color: #aaaeb6;

  font-size: 14px;
}


/* =====================================================
   GOLD
===================================================== */

.gold-list {
  display: grid;
  gap: 7px;
}

.gold {
  position: relative;

  overflow: hidden;

  padding: 15px;

  border-radius: 16px;

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(245,130,32,.2),
      transparent 34%
    ),
    #202633;

  color: white;
}

.gold:after {
  content: "✦";

  position: absolute;

  right: 11px;
  top: 2px;

  color: rgba(245,130,32,.55);

  font-size: 22px;
}

.gold-label {
  color: #ffae70;

  font-size: 6.5px;
  font-weight: 800;

  letter-spacing: .8px;

  text-transform: uppercase;
}

.gold p {
  position: relative;
  z-index: 1;

  margin: 6px 17px 0 0;

  font-family: "Baloo 2", sans-serif;

  color: #f7f9fb;

  font-size: 14px;

  line-height: 1.4;
}


/* =====================================================
   PRICING
===================================================== */

.price-grid {
  display: grid;
  gap: 7px;
}

.price-card {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 13px;

  border: 1px solid var(--border);

  border-radius: 14px;

  background: var(--surface);
}

.price-left {
  min-width: 0;
}

.price-speed {
  font-family: "Baloo 2", sans-serif;

  font-size: 18px;
  font-weight: 800;

  line-height: 1;
}

.price-description {
  margin-top: 3px;

  color: var(--muted);

  font-size: 7.5px;
}

.price-value {
  flex: 0 0 auto;

  color: var(--blue);

  font-family: "Baloo 2", sans-serif;

  font-size: 21px;
  font-weight: 800;

  line-height: 1;
}

.price-value small {
  font-family: "Inter", sans-serif;

  font-size: 7px;
  font-weight: 700;

  color: var(--muted);
}


/* =====================================================
   ADDONS
===================================================== */

.addon {
  padding: 13px;

  border: 1px solid var(--border);

  border-radius: 14px;

  background: var(--surface);
}

.addon + .addon {
  margin-top: 7px;
}

.addon-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;
}

.addon-title {
  font-size: 10px;
  font-weight: 800;
}

.addon-price {
  color: var(--orange-dark);

  font-family: "Baloo 2", sans-serif;

  font-size: 18px;
  font-weight: 800;

  line-height: 1;
}

.addon-text {
  margin: 5px 0 0;

  color: var(--muted);

  font-size: 8px;

  line-height: 1.45;
}

.info-box {
  margin-top: 9px;

  padding: 11px 12px;

  border-radius: 13px;

  background: var(--orange-soft);

  color: #71400f;

  font-size: 8px;

  line-height: 1.5;

  font-weight: 600;
}


/* =====================================================
   CALCULATOR
===================================================== */

.calculator {
  padding: 13px;

  border: 1px solid var(--border);

  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5f8fb
    );
}

.calc-intro {
  margin: 0 0 11px;

  color: var(--muted);

  font-size: 8px;

  line-height: 1.45;
}

.calc-fields {
  display: grid;
  gap: 8px;
}

.calc-field label {
  display: block;

  margin: 0 0 4px 2px;

  color: var(--muted);

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .7px;

  text-transform: uppercase;
}

.calc-input-wrap {
  position: relative;
}

.calc-input {
  width: 100%;

  height: 43px;

  padding: 0 34px 0 12px;

  border: 1px solid var(--border);

  border-radius: 11px;

  outline: none;

  background: var(--surface);

  color: var(--text);

  font-size: 12px;
  font-weight: 700;

  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

.calc-input:focus {
  border-color: var(--blue);

  box-shadow:
    0 0 0 3px rgba(0,91,170,.08);
}

.calc-euro {
  position: absolute;

  right: 12px;
  top: 50%;

  transform: translateY(-50%);

  color: var(--muted);

  font-size: 11px;
  font-weight: 800;
}

.calc-button {
  width: 100%;

  min-height: 45px;

  margin-top: 10px;

  border: 0;

  border-radius: 12px;

  background: var(--blue);

  color: white;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 7px 18px rgba(0,91,170,.18);

  transition:
    transform .15s ease,
    background .2s ease;
}

.calc-button:active {
  transform: scale(.985);
}

.calc-button:hover {
  background: var(--blue-dark);
}


/* =====================================================
   CALCULATOR RESULT
===================================================== */

.calc-result {
  display: none;

  margin-top: 10px;
}

.calc-result.show {
  display: block;
}

.result-main {
  padding: 15px;

  border-radius: 16px;

  background: var(--green-soft);

  border: 1px solid #cdebdc;
}

.result-kicker {
  color: var(--green-dark);

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .8px;

  text-transform: uppercase;
}

.result-saving {
  margin-top: 3px;

  color: var(--green-dark);

  font-family: "Baloo 2", sans-serif;

  font-size: 32px;
  font-weight: 800;

  line-height: 1;
}

.result-saving small {
  font-family: "Inter", sans-serif;

  font-size: 8px;
  font-weight: 700;
}

.result-grid {
  display: grid;

  grid-template-columns: repeat(2,minmax(0,1fr));

  gap: 6px;

  margin-top: 8px;
}

.result-box {
  padding: 10px;

  border: 1px solid var(--border);

  border-radius: 11px;

  background: var(--surface);
}

.result-box-label {
  color: var(--muted);

  font-size: 6.5px;
  font-weight: 800;

  text-transform: uppercase;
}

.result-box-value {
  margin-top: 3px;

  font-family: "Baloo 2", sans-serif;

  font-size: 18px;
  font-weight: 800;

  line-height: 1;
}

.result-box-value.blue {
  color: var(--blue);
}

.result-box-value.orange {
  color: var(--orange-dark);
}

.result-box-value.green {
  color: var(--green-dark);
}

.result-box-value.red {
  color: var(--red-dark);
}


/* =====================================================
   BREAK EVEN
===================================================== */

.break-even {
  margin-top: 7px;

  padding: 11px 12px;

  border-radius: 12px;

  background: var(--yellow-soft);

  color: #68521a;

  font-size: 8px;

  line-height: 1.45;
}

.break-even strong {
  font-weight: 800;
}


/* =====================================================
   BENEFIT WORDING
===================================================== */

.benefit-phrases {
  margin-top: 8px;

  display: grid;
  gap: 6px;
}

.benefit-title {
  color: var(--blue);

  font-size: 7px;
  font-weight: 800;

  letter-spacing: .8px;

  text-transform: uppercase;
}

.benefit-phrase {
  padding: 11px 12px;

  border-radius: 12px;

  background: var(--blue-soft);

  color: #254b6e;

  font-family: "Baloo 2", sans-serif;

  font-size: 13px;

  line-height: 1.35;
}


/* =====================================================
   BUSINESS
===================================================== */

.business-daily-grid {
  display: grid;

  gap: 7px;

  margin-bottom: 9px;
}

.business-daily-card {
  padding: 13px;

  border: 1px solid #cdebdc;

  border-radius: 14px;

  background: var(--green-soft);

  text-align: center;
}

.business-daily-price {
  color: var(--green-dark);

  font-family: "Baloo 2", sans-serif;

  font-size: 24px;

  font-weight: 800;

  line-height: 1;
}

.business-daily-label {
  margin-top: 3px;

  color: var(--muted);

  font-size: 7px;

  font-weight: 800;

  text-transform: uppercase;
}

.business-daily-per-day {
  margin-top: 7px;

  color: var(--text);

  font-size: 8px;
}

.business-daily-per-day strong {
  color: var(--green-dark);
}

.business-phrases {
  display: grid;

  gap: 7px;
}

.business-phrase {
  display: flex;

  align-items: flex-start;

  gap: 10px;

  padding: 12px;

  border: 1px solid var(--border);

  border-radius: 13px;

  background: var(--surface);
}

.business-phrase-number {
  width: 25px;
  height: 25px;

  flex: 0 0 25px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 8px;

  background: var(--green-soft);

  color: var(--green-dark);

  font-size: 7px;

  font-weight: 800;
}

.business-phrase-text {
  flex: 1;

  font-family: "Baloo 2", sans-serif;

  font-size: 13px;

  line-height: 1.4;

  color: var(--text);
}

.business-phrase-text strong {
  color: var(--green-dark);
}


/* =====================================================
   WINBACK
===================================================== */

.winback {
  border-top: 3px solid var(--orange);
}

.winback .subcategory-button {
  background:
    linear-gradient(
      90deg,
      var(--orange-soft),
      transparent
    );
}

.winback-note {
  margin-bottom: 8px;

  padding: 10px 12px;

  border-radius: 12px;

  background: var(--orange-soft);

  color: #75430f;

  font-size: 8px;

  line-height: 1.45;

  font-weight: 600;
}


/* =====================================================
   FOOTER
===================================================== */

footer {
  margin-top: 24px;

  padding-top: 16px;

  border-top: 1px solid var(--border);

  color: var(--muted);

  text-align: center;

  font-size: 7.5px;

  line-height: 1.5;
}

footer strong {
  color: var(--blue);
}


/* =====================================================
   DARK MODE
===================================================== */

body.dark {
  --bg: #171b21;

  --surface: #252b34;
  --surface2: #343b46;

  --text: #eef2f6;
  --muted: #aab2bd;

  --border: #3a424d;

  --blue-soft: #193552;
  --orange-soft: #422d1d;

  --green-soft: #1c382b;
  --red-soft: #3e292b;
  --yellow-soft: #3b3421;

  --blue: #63a9e7;
  --blue-dark: #83bcea;

  --orange: #ff9b4a;
  --orange-dark: #ffab62;

  --green-dark: #6ed29f;
  --red-dark: #ef9292;
}

body.dark .hero {
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(245,130,32,.7),
      transparent 31%
    ),
    radial-gradient(
      circle at 0% 100%,
      rgba(0,91,170,.8),
      transparent 40%
    ),
    #202633;
}

body.dark .example p {
  color: #eadcae;
}

body.dark .info-box,
body.dark .winback-note {
  color: #f0c995;
}

body.dark .benefit-phrase {
  color: #d7e7f5;
}


/* =====================================================
   DESKTOP
===================================================== */

@media (min-width: 700px) {

  .page {
    padding-top: 26px;
  }

  .hero {
    padding: 34px;
  }

  .accordion-body {
    padding: 0 14px 15px;
  }

  .phrase-list {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .gold-list {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .price-grid {
    grid-template-columns:
      repeat(3,minmax(0,1fr));
  }

  .calc-fields {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .calc-button {
    grid-column: 1 / -1;
  }

  .business-daily-grid {
    grid-template-columns:
      repeat(3,minmax(0,1fr));
  }

}


/* =====================================================
   SMALL PHONES
===================================================== */

@media (max-width: 360px) {

  .page {
    padding-left: 10px;
    padding-right: 10px;
  }

  .hero {
    padding-left: 17px;
    padding-right: 17px;
  }

  .section-name {
    font-size: 20px;
  }

  .subcategory-title {
    font-size: 10px;
  }

  .swap {
    grid-template-columns:
      minmax(0,1fr)
      18px
      minmax(0,1fr);
  }

  .swap-text {
    font-size: 8.7px;
  }

}


/* =====================================================
   PRINT
===================================================== */

@media print {

  .theme-button {
    display: none;
  }

  .page {
    max-width: none;
  }

}

</style>
</head>


<body>

<div class="page">


<!-- =====================================================
     HEADER
===================================================== -->

<header class="topbar">

  <div class="logo-area">

    <div class="eyebrow">
      SALES TOOLKIT
    </div>

    <div class="logo">
      Λεκτικά <span>✦</span>
    </div>

  </div>

  <button
    class="theme-button"
    id="themeButton"
    aria-label="Αλλαγή θέματος"
  >
    ☾
  </button>

</header>


<!-- =====================================================
     HERO
===================================================== -->

<section class="hero">

  <div class="hero-badge">
    🎯 Μίλα σωστά · Πούλα συμβουλευτικά
  </div>

  <h1>
    Οι σωστές λέξεις<br>
    <span>αλλάζουν τη συζήτηση.</span>
  </h1>

  <p class="hero-description">
    Γρήγορο cheat sheet με λεκτικά,
    τιμές και υπολογισμό οφέλους για
    καθημερινή χρήση.
  </p>

</section>


<div class="intro">
  Ξεκίνα από τις ανάγκες του πελάτη,
  όχι από το προϊόν.
</div>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="accordion">


<!-- =====================================================
     01 ΛΕΚΤΙΚΑ
===================================================== -->

<section class="accordion-item">

  <button
    class="accordion-header"
    type="button"
    aria-expanded="false"
  >

    <div class="section-icon icon-blue">
      💬
    </div>

    <div class="section-info">

      <div class="section-number">
        01 · ΛΕΚΤΙΚΑ
      </div>

      <h2 class="section-name">
        Λεκτικά
      </h2>

      <div class="section-subtitle">
        Τι λες · τι αποφεύγεις · πώς κλείνεις
      </div>

    </div>

    <div class="chevron">
      ⌄
    </div>

  </button>


  <div class="accordion-content">

    <div class="accordion-inner">

      <div class="accordion-body">


        <!-- =========================
             ΕΜΠΙΣΤΟΣΥΝΗ
        ========================== -->

        <div class="subcategory">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              ✓
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                Χτίζουν εμπιστοσύνη
              </h3>

              <div class="subcategory-count">
                7 λεκτικά
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="phrase-list">

                  <div class="phrase phrase-positive">
                    <p>«Να δω αν σας αφορά.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Να δούμε αν ταιριάζει στη χρήση σας.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Αν έχει νόημα για εσάς.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Εφόσον σας εξυπηρετεί.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Δεν υπάρχει λόγος να πάτε σε κάτι που δεν χρειάζεστε.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Να σας εξηγήσω τις επιλογές και αποφασίζετε εσείς.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Εσείς γνωρίζετε καλύτερα τις ανάγκες σας.»</p>
                  </div>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =========================
             ΣΥΜΒΟΥΛΕΥΤΙΚΗ
        ========================== -->

        <div class="subcategory">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              💡
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                Συμβουλευτική πώληση
              </h3>

              <div class="subcategory-count">
                6 λεκτικά + παράδειγμα
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="phrase-list">

                  <div class="phrase phrase-positive">
                    <p>«Με βάση αυτά που μου λέτε...»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Από τη χρήση που μου περιγράφετε...»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Για τη δική σας περίπτωση...»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Αυτό που θα σας πρότεινα...»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Αυτό που βλέπω ότι σας ταιριάζει...»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Η πιο λογική επιλογή για εσάς είναι...»</p>
                  </div>

                </div>


                <div class="example">

                  <div class="example-label">
                    💡 Παράδειγμα
                  </div>

                  <p>
                    «Με βάση ότι έχετε δύο παιδιά,
                    τηλεόραση και τηλεργασία,
                    θα κοιτούσα περισσότερο το 1 Gbps.»
                  </p>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =========================
             ΑΞΙΑ
        ========================== -->

        <div class="subcategory">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              ✦
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                Φράσεις που αυξάνουν την αξία
              </h3>

              <div class="subcategory-count">
                5 λεκτικά
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="phrase-list">

                  <div class="phrase phrase-positive">
                    <p>«Πιο σταθερή εμπειρία.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Καλύτερη απόκριση.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Περισσότερη άνεση με πολλές συσκευές.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Λιγότερος ανταγωνισμός μέσα στο σπίτι όταν χρησιμοποιούν όλοι internet.»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Μεγαλύτερο περιθώριο για τις ανάγκες των επόμενων χρόνων.»</p>
                  </div>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =========================
             ΚΛΕΙΣΙΜΟ
        ========================== -->

        <div class="subcategory">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              →
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                Κλείσιμο χωρίς πίεση
              </h3>

              <div class="subcategory-count">
                5 λεκτικά
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="phrase-list">

                  <div class="phrase phrase-positive">
                    <p>«Να το δούμε μαζί;»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Να κάνουμε έναν έλεγχο;»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Να δούμε αν υπάρχει διαθέσιμη επιλογή;»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Να σας δείξω τι μπορείτε να έχετε;»</p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>«Αν σας καλύπτει, προχωράμε. Αν όχι, το αφήνουμε.»</p>
                  </div>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =========================
             ΑΠΟΦΥΓΕ
        ========================== -->

        <div class="subcategory red">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              ×
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                Απόφυγε αυτά
              </h3>

              <div class="subcategory-count">
                6 βασικά λεκτικά
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="phrase-list">

                  <div class="phrase phrase-negative">
                    <p>«Πρέπει να το κάνετε σήμερα.»</p>
                  </div>

                  <div class="phrase phrase-negative">
                    <p>«Είναι η τελευταία ευκαιρία.»</p>
                  </div>

                  <div class="phrase phrase-negative">
                    <p>«Πρέπει να αποφασίσετε τώρα.»</p>
                  </div>

                  <div class="phrase phrase-negative">
                    <p>«Είναι το καλύτερο της αγοράς.»</p>
                  </div>

                  <div class="phrase phrase-negative">
                    <p>«Δεν θα έχετε ποτέ πρόβλημα.»</p>
                  </div>

                  <div class="phrase phrase-negative">
                    <p>«Όλοι το παίρνουν.»</p>
                  </div>

                </div>

                <div class="better">

                  <div class="better-title">
                    ✨ Πες καλύτερα
                  </div>

                  <div class="phrase-list">

                    <div class="phrase phrase-positive">
                      <p>«Να δούμε αν σας ταιριάζει.»</p>
                    </div>

                    <div class="phrase phrase-positive">
                      <p>«Να σας εξηγήσω τις επιλογές και αποφασίζετε εσείς.»</p>
                    </div>

                  </div>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =========================
             ΜΗΝ ΠΕΙ → ΠΕΣ
        ========================== -->

        <div class="subcategory">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              ↔
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                Μην πεις → Πες
              </h3>

              <div class="subcategory-count">
                6 γρήγορες αντικαταστάσεις
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="swap-list">

                  <div class="swap">

                    <div class="swap-side swap-bad">
                      <div class="swap-label">❌ Απόφυγε</div>
                      <div class="swap-text">«Θέλετε Fiber;»</div>
                    </div>

                    <div class="swap-arrow">→</div>

                    <div class="swap-side swap-good">
                      <div class="swap-label">✓ Πες</div>
                      <div class="swap-text">«Να δούμε αν το Fiber σας ταιριάζει;»</div>
                    </div>

                  </div>


                  <div class="swap">

                    <div class="swap-side swap-bad">
                      <div class="swap-label">❌ Απόφυγε</div>
                      <div class="swap-text">«Έχουμε προσφορά.»</div>
                    </div>

                    <div class="swap-arrow">→</div>

                    <div class="swap-side swap-good">
                      <div class="swap-label">✓ Πες</div>
                      <div class="swap-text">«Υπάρχουν διαθέσιμες επιλογές.»</div>
                    </div>

                  </div>


                  <div class="swap">

                    <div class="swap-side swap-bad">
                      <div class="swap-label">❌ Απόφυγε</div>
                      <div class="swap-text">«Είναι καλύτερο.»</div>
                    </div>

                    <div class="swap-arrow">→</div>

                    <div class="swap-side swap-good">
                      <div class="swap-label">✓ Πες</div>
                      <div class="swap-text">«Είναι διαφορετική τεχνολογία.»</div>
                    </div>

                  </div>


                  <div class="swap">

                    <div class="swap-side swap-bad">
                      <div class="swap-label">❌ Απόφυγε</div>
                      <div class="swap-text">«Θα έχετε τέλειο internet.»</div>
                    </div>

                    <div class="swap-arrow">→</div>

                    <div class="swap-side swap-good">
                      <div class="swap-label">✓ Πες</div>
                      <div class="swap-text">«Στόχος είναι η μεγαλύτερη σταθερότητα.»</div>
                    </div>

                  </div>


                  <div class="swap">

                    <div class="swap-side swap-bad">
                      <div class="swap-label">❌ Απόφυγε</div>
                      <div class="swap-text">«Πρέπει να υπογράψετε.»</div>
                    </div>

                    <div class="swap-arrow">→</div>

                    <div class="swap-side swap-good">
                      <div class="swap-label">✓ Πες</div>
                      <div class="swap-text">«Αν σας καλύπτει, μπορούμε να προχωρήσουμε.»</div>
                    </div>

                  </div>


                  <div class="swap">

                    <div class="swap-side swap-bad">
                      <div class="swap-label">❌ Απόφυγε</div>
                      <div class="swap-text">«Είναι φθηνό.»</div>
                    </div>

                    <div class="swap-arrow">→</div>

                    <div class="swap-side swap-good">
                      <div class="swap-label">✓ Πες</div>
                      <div class="swap-text">«Έχει καλή σχέση κόστους/απόδοσης.»</div>
                    </div>

                  </div>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =========================
             WINBACK
        ========================== -->

        <div class="subcategory winback">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              ↩
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                Winback
              </h3>

              <div class="subcategory-count">
                Προετοιμασία πριν την αντιπροσφορά
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="winback-note">
                  🎯 Στόχος δεν είναι να φοβίσουμε τον πελάτη.
                  Τον βοηθάμε να αξιολογήσει μια πιθανή
                  αντιπροσφορά πέρα από την έκπτωση.
                </div>


                <div class="phrase-list">

                  <div class="phrase phrase-positive">
                    <p>
                      «Όταν σας καλέσει ο προηγούμενος πάροχος,
                      μην κοιτάξετε μόνο πόσα ευρώ θα πληρώνετε.
                      Δείτε και τι υπηρεσία θα έχετε.»
                    </p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>
                      «Με αυτή την τιμή τι ακριβώς παίρνω;
                      Παραμένει η ίδια τεχνολογία ή αναβαθμίζεται
                      και η σύνδεσή μου;»
                    </p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>
                      «Αν δεν υπήρχε η έκπτωση,
                      θα επέλεγα ξανά την ίδια υπηρεσία;»
                    </p>
                  </div>

                  <div class="phrase phrase-positive">
                    <p>
                      «Η επιλογή παρόχου καλό είναι να γίνεται
                      με βάση το τι θα σας εξυπηρετεί καθημερινά
                      και όχι μόνο την τιμή της ημέρας.»
                    </p>
                  </div>

                </div>


                <div class="example">

                  <div class="example-label">
                    🔒 Κλείδωμα
                  </div>

                  <p>
                    «Αν σας καλέσει ο προηγούμενος πάροχος,
                    κρατήστε την ίδια σύγκριση:
                    τιμή + τεχνολογία + εμπειρία χρήσης.»
                  </p>

                </div>

              </div>

            </div>

          </div>

        </div>


      </div>

    </div>

  </div>

</section>


<!-- =====================================================
     02 ΤΙΜΕΣ & ΠΑΚΕΤΑ
===================================================== -->

<section class="accordion-item">

  <button
    class="accordion-header"
    type="button"
    aria-expanded="false"
  >

    <div class="section-icon icon-orange">
      €
    </div>

    <div class="section-info">

      <div class="section-number">
        02 · ΤΙΜΕΣ
      </div>

      <h2 class="section-name">
        Τιμές & Πακέτα
      </h2>

      <div class="section-subtitle">
        Γρήγορη αναφορά για τις βασικές επιλογές
      </div>

    </div>

    <div class="chevron">
      ⌄
    </div>

  </button>


  <div class="accordion-content">

    <div class="accordion-inner">

      <div class="accordion-body">


        <!-- =========================
             INTERNET
        ========================== -->

        <div class="subcategory orange">

          <button
            class="subcategory-button"
            type="button"
            aria-expanded="false"
          >

            <div class="subcategory-icon">
              ⚡
            </div>

            <div class="subcategory-info">

              <h3 class="subcategory-title">
                ΔΕΗ Fiber Internet
              </h3>

              <div class="subcategory-count">
                Μηνιαίο πάγιο
              </div>

            </div>

            <div class="subcategory-chevron">
              ⌄
            </div>

          </button>


          <div class="subcategory-content">

            <div class="subcategory-inner">

              <div class="subcategory-body">

                <div class="price-grid">

                  <div class="price-card">

                    <div class="price-left">
                      <div class="price-speed">
                        500 Mbps
                      </div>

                      <div class="price-description">
                        Fiber Internet
                      </div>
                    </div>

                    <div class="price-value">
                      €17,90
                      <small>/μήνα</small>
                    </div>

                  </div>


                  <div class="price-card">

                    <div class="price-left">
                      <div class="price-speed">
                        1000 Mbps
                      </div>

                      <div class="price-description">
                        Fiber Internet
                      </div>
                    </div>

                    <div class="price-value">
                      €19,90
                      <small>/μήνα</small>
                    </div>

                  </div>


                  <div class="price-card">

                    <div class="price-left">
                      <div class="price-speed">
                        2.5 Gbps
                      </div>

                      <div class="price-description">
                        Fiber Internet
                      </div>
