  Μην μιλάς πάνω στον πελάτη.

</footer>


</div>


<script>

/* =====================================================
   MAIN ACCORDION
===================================================== */

const accordionItems =
  document.querySelectorAll(".accordion-item");


accordionItems.forEach(item => {

  const header =
    item.querySelector(".accordion-header");


  header.addEventListener("click", () => {

    const isOpen =
      item.classList.contains("open");


    accordionItems.forEach(other => {

      other.classList.remove("open");

      other
        .querySelector(".accordion-header")
        .setAttribute(
          "aria-expanded",
          "false"
        );

    });


    if (!isOpen) {

      item.classList.add("open");

      header.setAttribute(
        "aria-expanded",
        "true"
      );

      setTimeout(() => {

        const top =
          item.getBoundingClientRect().top +
          window.scrollY -
          10;

        window.scrollTo({
          top: top,
          behavior: "smooth"
        });

      }, 80);

    }

  });

});


/* =====================================================
   SUBCATEGORIES
===================================================== */

const subcategories =
  document.querySelectorAll(".subcategory");


subcategories.forEach(subcategory => {

  const button =
    subcategory.querySelector(".subcategory-button");


  button.addEventListener("click", event => {

    event.stopPropagation();


    const isOpen =
      subcategory.classList.contains("open");


    const parentMain =
      subcategory.closest(".accordion-item");


    parentMain
      .querySelectorAll(".subcategory")
      .forEach(other => {

        other.classList.remove("open");

        other
          .querySelector(".subcategory-button")
          .setAttribute(
            "aria-expanded",
            "false"
          );

      });


    if (!isOpen) {

      subcategory.classList.add("open");

      button.setAttribute(
        "aria-expanded",
        "true"
      );

    }

  });

});


/* =====================================================
   DARK MODE
===================================================== */

const themeButton =
  document.getElementById("themeButton");


themeButton.addEventListener(
  "click",
  () => {

    document.body.classList.toggle("dark");

    const dark =
      document.body.classList.contains("dark");

    themeButton.textContent =
      dark ? "☀" : "☾";

  }
);


/* =====================================================
   CALCULATOR
===================================================== */

const oldPriceInput =
  document.getElementById("oldPrice");

const newPriceInput =
  document.getElementById("newPrice");

const penaltyInput =
  document.getElementById("penalty");

const calculateButton =
  document.getElementById("calculateButton");

const calcResult =
  document.getElementById("calcResult");

const old12 =
  document.getElementById("old12");

const new12 =
  document.getElementById("new12");

const saving12 =
  document.getElementById("saving12");

const saving24 =
  document.getElementById("saving24");

const resultPenalty =
  document.getElementById("resultPenalty");

const net12 =
  document.getElementById("net12");

const result24 =
  document.getElementById("result24");

const breakEven =
  document.getElementById("breakEven");

const benefitPhrase =
  document.getElementById("benefitPhrase");

const benefitPhrase2 =
  document.getElementById("benefitPhrase2");


/* =====================================================
   MONEY FORMAT
===================================================== */

function money(value) {

  return new Intl.NumberFormat(
    "el-GR",
    {
      style: "currency",
      currency: "EUR",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }
  ).format(value);

}


/* =====================================================
   CALCULATE BENEFIT
===================================================== */

function calculateBenefit() {

  const oldPrice =
    parseFloat(oldPriceInput.value) || 0;

  const newPrice =
    parseFloat(newPriceInput.value) || 0;

  const penalty =
    parseFloat(penaltyInput.value) || 0;


  /* =========================
     TOTALS
  ========================== */

  const oldTotal12 =
    oldPrice * 12;

  const newTotal12 =
    newPrice * 12;

  const oldTotal24 =
    oldPrice * 24;

  const newTotal24 =
    newPrice * 24;


  /* =========================
     SAVINGS
  ========================== */

  const saving12Value =
    oldTotal12 - newTotal12;

  const saving24Value =
    oldTotal24 - newTotal24;


  /* =========================
     NET BENEFIT
  ========================== */

  const net12Value =
    saving12Value - penalty;

  const net24Value =
    saving24Value - penalty;


  /* =========================
     DISPLAY
  ========================== */

  old12.textContent =
    money(oldTotal12);

  new12.textContent =
    money(newTotal12);

  saving12.textContent =
    money(saving12Value);

  saving24.textContent =
    money(saving24Value);

  resultPenalty.textContent =
    money(penalty);

  net12.textContent =
    money(net12Value);

  result24.innerHTML =
    money(net24Value) +
    ' <small>στο 24μηνο</small>';


  /* =========================
     COLORS
  ========================== */

  net12.classList.remove(
    "green",
    "red"
  );

  result24.classList.remove(
    "green",
    "red"
  );


  if (net12Value >= 0) {

    net12.classList.add("green");

  } else {

    net12.classList.add("red");

  }


  if (net24Value >= 0) {

    result24.classList.add("green");

  } else {

    result24.classList.add("red");

  }


  /* =========================
     BREAK EVEN
  ========================== */

  if (
    penalty > 0 &&
    oldPrice > newPrice
  ) {

    const monthlySaving =
      oldPrice - newPrice;

    const months =
      penalty / monthlySaving;


    if (months <= 24) {

      breakEven.innerHTML =
        "⏱️ Η ρήτρα των " +
        "<strong>" +
        money(penalty) +
        "</strong>" +
        " αποσβένεται σε περίπου " +
        "<strong>" +
        months.toFixed(1) +
        " μήνες</strong>.";

    } else {

      breakEven.innerHTML =
        "⏱️ Η ρήτρα αποσβένεται σε περίπου " +
        "<strong>" +
        months.toFixed(1) +
        " μήνες</strong>, " +
        "άρα η πλήρης απόσβεση ξεπερνά το 24μηνο.";

    }

  } else if (
    penalty === 0 &&
    oldPrice > newPrice
  ) {

    breakEven.innerHTML =
      "✓ Δεν υπάρχει ρήτρα. " +
      "Η διαφορά στο πάγιο δημιουργεί όφελος από τον πρώτο μήνα.";

  } else if (
    penalty > 0 &&
    oldPrice <= newPrice
  ) {

    breakEven.innerHTML =
      "⚠️ Η ρήτρα είναι επιπλέον κόστος και " +
      "με τις συγκεκριμένες τιμές δεν υπάρχει " +
      "μηνιαία εξοικονόμηση για να την αποσβέσει.";

  } else {

    breakEven.innerHTML =
      "Η διαφορά παγίου δεν δημιουργεί εξοικονόμηση " +
      "με τις συγκεκριμένες τιμές.";

  }


  /* =========================
     SALES WORDING
  ========================== */

  if (net24Value <= 0) {

    benefitPhrase.textContent =
      "«Ας δούμε πρώτα το πραγματικό κόστος και πότε αποσβένεται η ρήτρα.»";

    benefitPhrase2.textContent =
      "«Δεν κοιτάμε μόνο την τιμή· κοιτάμε τη συνολική εικόνα του 24μήνου.»";

  }

  else if (net24Value < 50) {

    benefitPhrase.textContent =
      "«Στο 24μηνο μένει καθαρό όφελος περίπου " +
      money(net24Value) +
      ".»";

    benefitPhrase2.textContent =
      "«Είναι ένα ποσό που διαφορετικά θα έμενε στη διαφορά του παγίου.»";

  }

  else if (net24Value < 100) {

    benefitPhrase.textContent =
      "«Με τα " +
      money(net24Value) +
      " που κερδίζετε, βλέπετε πλέον καθαρά ότι η αλλαγή αρχίζει να σας συμφέρει.»";

    benefitPhrase2.textContent =
      "«Αυτό είναι το πραγματικό όφελος αφού υπολογίσουμε και τη ρήτρα.»";

  }

  else if (net24Value < 200) {

    benefitPhrase.textContent =
      "«Με τα " +
      money(net24Value) +
      " καθαρό όφελος στο 24μηνο, η διαφορά γίνεται πλέον ουσιαστική.»";

    benefitPhrase2.textContent =
      "«Και αυτό είναι επιπλέον της αναβάθμισης της σύνδεσής σας.»";

  }

  else {

    benefitPhrase.textContent =
      "«Με τα " +
      money(net24Value) +
      " καθαρό όφελος στο 24μηνο, ουσιαστικά κρατάτε αυτό το ποσό στην τσέπη σας.»";

    benefitPhrase2.textContent =
      "«Και παράλληλα έχετε μια διαφορετική τεχνολογία και νέα σύνδεση.»";

  }


  /* =========================
     SHOW RESULT
  ========================== */

  calcResult.classList.add("show");

}


/* =====================================================
   CALCULATE BUTTON
===================================================== */

calculateButton.addEventListener(
  "click",
  calculateBenefit
);


/* =====================================================
   ENTER KEY
===================================================== */

[
  oldPriceInput,
  newPriceInput,
  penaltyInput

].forEach(input => {

  input.addEventListener(
    "keydown",
    event => {

      if (event.key === "Enter") {

        calculateBenefit();

      }

    }
  );

});


</script>

</body>
</html>
